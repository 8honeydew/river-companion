{
    "manifest_version": 3,
    "name": "River",
    "version": "0.1.0",
    "description": "A small companion that lives in your browser.",

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["content.css"]
        }
    ],

    "permissions": [
        "storage"
    ]
}